# Copy this file to .env.local and fill in your values.
# All variables marked REQUIRED must be set for the site to work.

# ── Database (MySQL / TiDB Cloud) ────────────────────────
# REQUIRED — MySQL connection string
DATABASE_URL="mysql://user:password@host:4000/dbname"

# Optional — path to SSL CA cert (needed for TiDB Cloud)
DB_SSL_CA="db/isrgrootx1.pem"

# Optional — reject unauthorized SSL certs (true in production)
DB_SSL_REJECT_UNAUTHORIZED=true

# ── Admin credentials ─────────────────────────────────────
# REQUIRED — Admin login credentials for the /admin CMS panel
ADMIN_USER=admin@yourdomain.com
ADMIN_PASS=YourSecurePassword123

# ── Optional / future ─────────────────────────────────────
# NEXTAUTH_SECRET=your-random-secret   # if you add NextAuth
# SMTP_HOST=smtp.example.com           # if you add email sending
# SMTP_PORT=587
# SMTP_USER=mailer@yourdomain.com
# SMTP_PASS=your-smtp-password
