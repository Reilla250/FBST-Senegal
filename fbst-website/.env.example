# Copy this file to .env.local and fill in your values.
# All variables marked REQUIRED must be set for the site to work.

# ── Database (TiDB Cloud / MySQL-compatible) ──────────────────────────────
# REQUIRED — TiDB Cloud connection string (found in Connect > Connection String)
DATABASE_URL="mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/dbname"

# REQUIRED for TiDB Cloud — path to the CA certificate bundled in this repo
DB_SSL_CA="db/isrgrootx1.pem"

# ── Admin credentials ─────────────────────────────────────────────────────
# REQUIRED — Admin login credentials for the /admin CMS panel.
# Change these before deploying to production.
ADMIN_USER=admin@yourdomain.com
ADMIN_PASS=YourSecurePassword123

# ── Optional / future ─────────────────────────────────────────────────────
# NEXTAUTH_SECRET=your-random-secret   # if you add NextAuth
# SMTP_HOST=smtp.example.com           # if you add email sending
# SMTP_PORT=587
# SMTP_USER=mailer@yourdomain.com
# SMTP_PASS=your-smtp-password
